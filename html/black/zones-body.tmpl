<div id="zones">
    [% FOREACH item IN players %]
        [% IF item.zone.is_coord %]
    <div [% IF item.isactive %] class="active" [% ELSE %] class="normal" [% END %]>
                [% UNLESS item.isactive %]
                    <img style='float: right;' onclick="goto('zones', 'action=Link&link=[% item.name %]'); return true;" src="svg/link.svg">
                [% ELSIF item.zone.members.size > 1 %]
                    <img style='float: right;' onclick="goto('zones', 'action=Unlink&link=[% item.name %]');" src="svg/unlink.svg">
                [% END %]

                <ul onclick="zone('[% item.name %]');">
                    [% FOREACH member IN item.zone.members %]
                        <li style="background-image: url('[% member.img %]');">
                            [% member.name %]
                        </li>
                    [% END %]
                </ul>

                <div class="zoneinfo">
                    <span>
                        [% IF item.av.transport_state == "PLAYING" %]
                            <img src="svg/play.svg">
                        [% ELSE %]
                            <img src="svg/pause.svg">
                        [% END %]
                        [% item.av.album %]
                    </span>
                </div>
            </div>
        [% END %]
    [% END %]
</div>
