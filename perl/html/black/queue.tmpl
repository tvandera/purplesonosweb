<div id="queue">
    <div id="queuedata">
        <ul>
            <li class="header">
                <button type="button" class="queue-toggle" onclick="toggleQueue();" aria-label="Toggle queue">
                    <img src="svg/queue.png" alt="">
                </button>
                <div>
                    <p>&nbsp;</p>
                    <p class="buttons" onclick="removeall()">Remove All</p>
                </div>
            </li>
            [% FOREACH item IN player.queue.items %]
                <li onclick="seek('[% item.arg %]');">
                    <img class="albumart" src="[% item.albumart %]" />
                    <div>
                        <p class="title">[% item.title %]</p>
                        <p class="artist">[% item.artist %]</p>
                    </div>
                </li>
            [% END %]
        </ul>
    </div>
</div>
